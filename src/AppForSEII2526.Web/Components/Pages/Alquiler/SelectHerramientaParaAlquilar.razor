@page "/alquiler/selectherramientaparaalquilar"

@using AppForSEII2526.Web.API
@inject AppForHerramientasAPIClient apiclient
@inject ILogger<SelectHerramientaParaAlquilar> logger
@inject AlquilarStateContainer alquilerState
@inject NavigationManager navigation

<h3>SelectHerramientaParaAlquilar</h3>
<div class="container-fluid">
    <div class="row alert alert-danger" role="alert" hidden="@hideErrors">
        <p id="ErrorsShown">Errors: @errors</p>
    </div>
    <div class="row">
        <div class="col-8">
            <div class="row">
                <div class="col">
                    <div class="col">
                        <div class="input-group mb-3">
                            <span class="input-group-text" id="basic-addon1">Nombre</span>
                            <input type="text" id="insertarNombre" @bind=filtroNombre class="form-control" placeholder="Nombre" aria-label="Nombre" aria-describedby="basic-addon1">
                        </div>
                    </div>
                    <div class="col">
                        <div class="input-group mb-3">
                            <span class="input-group-text" id="basic-addon1">Material</span>
                            <input type="text" id="insertarMaterial" @bind=filtroMaterial class="form-control" placeholder="Material" aria-label="Material" aria-describedby="basic-addon1">
                        </div>
                    </div>
                    <div class="col">
                        <div class="input-group mb-3">
                        </div>
                    </div>                   
                    <button type="button" class="btn btn-primary" @onclick=@BuscarHerramientas id="buscarHerramientas">Buscar herramientas</button>
                
                </div>
            </div>
            <div class="row">
                @if (herramientas == null)
                {
                    <p>Cargando herramientas....</p>
                }
                else
                {
                    <div class="mh-100 table-responsive">
                        <table class="table table-condensed table-hover" id="TablaDeHerramientas">
                            <thead>
                                <tr>
                                    <th>Nombre</th>
                                    <th>Material</th>
                                    <th>Fabricante</th>
                                    <th>Precio</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var herramienta in herramientas)
                                {
                                    <tr id="DatosHerramientas_@herramienta.Id">
                                        <td>@herramienta.Nombre</td>
                                        <td>@herramienta.Material</td>
                                        <td>@herramienta.Fabricante</td>
                                        <td>@herramienta.Precio</td>
                                        <td>
                                            <button class="btn btn-outline-secondary" id="herramientaParaAlquilar_@herramienta.Id" @onclick="@(() => InsertarHerramienta(herramienta))">Add</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                }
            </div>
        </div>
        <div class="col-2" hidden="@hideRentingCart">
            <div class="row">
                <h3>Carrito de la compra</h3>
            </div>
            @foreach (AlquilarItemDTO item in alquiler.AlquilerItems)
            {
                <div class="row">
                    <button type="button" class="btn btn-light" id="eliminarHerramienta_@item.Id" @onclick="@(() => EliminarItemAlquiler(item))">x @item.Id - @item.Precio€</button>
                </div>
            }
            <div class="row">
                <button type="button" class="btn btn-primary" id="alquilarHerramientaButton" @onclick=@AlquilarHerramientas>Alquilar herramientas</button>
            </div>
        </div>

    </div>


</div>
@code {
    private bool hideRentingCart { get { return alquiler.AlquilerItems.Count == 0; } }
    private ICollection<HerramientaParaAlquilarDTO> herramientas;
    private bool hideErrors { get { return errors.Length == 0; } }
    private string errors = "";
    private string filtroNombre { get; set; }
    private string filtroMaterial { get; set; }
    private CreacionAlquilerDTO alquiler => alquilerState.Alquiler;

    private bool hiddenRentingCart = true;

    private void InsertarHerramienta(HerramientaParaAlquilarDTO herramienta)
    {
        alquilerState.AgregarHerramientaParaAlquilar(herramienta);
    }

    private void EliminarItemAlquiler(AlquilarItemDTO item)
    {
        alquilerState.EliminarItemAlquilerParaAlquilar(item);
        if (alquiler.AlquilerItems.Count == 0) hiddenRentingCart = true;
    }
    public async void BuscarHerramientas()
    {
        try
        {
            herramientas = await apiclient.GetHerramientasParaAlquilarAsync(filtroNombre, filtroMaterial);
            errors = "";
        }
        catch (ApiException ex)
        {
            logger.LogError($"{DateTime.Now} Error: {ex}");
            errors = "Error while connecting to the system";
        }
        StateHasChanged();
    }
    protected override Task OnInitializedAsync()
    {
        BuscarHerramientas();

        return base.OnInitializedAsync();
    }
    private void AlquilarHerramientas()
    {
        navigation.NavigateTo("/alquiler/crearalquiler");
    }

}
