@page "/alquiler/crearalquiler"

@inject NavigationManager navigation
@using AppForSEII2526.Web.Components.Shared
@using AppForSEII2526.Web.API
@using Microsoft.AspNetCore.Authorization
@inject AppForHerramientasAPIClient apiclient
@inject ILogger<CrearAlquiler> logger
@inject AlquilarStateContainer alquilarState

@* @attribute [Authorize] *@

<h3>CrearAlquiler</h3>

<EditForm Model="alquiler" OnValidSubmit="OpenDialog">
    <div class="row">
        <DataAnnotationsValidator />
        <ValidationSummary class="row alert alert-danger" />
    </div>
    <div class="row alert alert-danger" role="alert" hidden="@hideErrors">
        <p id="ErrorsShown">Errors: @messageError</p>
    </div>
    <div class="row g-3">
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="alquiler.Name" class="form-control" id="Name" />
                <label for="Name">Nombre </label>
            </div>
        </div>
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="alquiler.Surname" class="form-control" id="Surname" />
                <label for="Surname">Apellido </label>
            </div>
        </div>
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="alquiler.DireccionEnvio" class="form-control" id="DireccionEnvio" />
                <label for="DireccionEnvio">Direccion de envio</label>
            </div>
        </div>
    </div>
    <div class="row g-2">
        <div class="col-md">
            <div class="form-floating">
                <InputSelect class="form-select" @bind-Value="@alquiler.MetodoPago" id="MetodoPago">
                    <option value="@TiposMetodoPago.TarjetaCredito" default> TarjetaCredito</option>
                    <option value="@TiposMetodoPago.PayPal"> PayPal</option>
                    <option value="@TiposMetodoPago.Efectivo"> Efectivo</option>
                </InputSelect>
                <label for="MetodoPago">Metodo de Pago</label>
            </div>
        </div>
        <div class="col-md">
            <div class="form-floating">
                <button class="btn btn-primary" type="submit" id="Submit">
                    Alquila tus herramientas
                </button>
            </div>
        </div>
    </div>
    <h4>Detalle alquiler</h4>
    <div class="row g-2 mb-3">
        <div class="col-md">
            <div class="form-floating">
                <InputDate @bind-Value="alquiler.FechaInicio" class="form-control" id="FechaInicio" />
                <label for="FechaInicio">Fecha Inicio</label>
            </div>
        </div>
        <div class="col-md">
            <div class="form-floating">
                <InputDate @bind-Value="alquiler.FechaFin" class="form-control" id="FechaFin" />
                <label for="FechaFin">Fecha Fin</label>
            </div>
        </div>
    </div>
    <p>
        <b>Precio Total:</b> <span id="precioTotalCalculado">@CosteTotal</span> €
        <button class="btn btn-outline-primary" type="submit" @onclick="ModificarAlquilarItems" id="ModificarHerramientas">
            Modificar herramientas
        </button>
    </p>

    <div class="mh-100 table-responsive">
        <table class="table table-condensed table-hover" id="TablaAlquilarHerramientas">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Material</th>
                    <th>Precio</th>
                    <th>Cantidad</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in alquiler.AlquilerItems)
                {
                    <tr id="HerramientaData_@item.Id">
                        <td>@item.Nombre</td>
                        <td>@item.Material</td>
                        <td>@item.Precio</td>
                        <td><InputNumber @bind-Value="item.Cantidad" class="form-control" id="@($"cantidad_{item.Id}")"/></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</EditForm>

@if (DialogIsOpen)
{
    <Dialog Caption="Alquilar herramientas"
    Message="¿Quieres continuar para alquilar las herramientas seleccionadas?"
    OnClose="@OnDialogClose"
    Type=Dialog.Category.SaveNot>
    </Dialog>
}

@code {
    private string messageError = "";
    private bool hideErrors { get { return messageError.Length == 0; } }
    private bool DialogIsOpen;
    private decimal CosteTotal
    {
        get
        {
            int dias = (alquiler.FechaFin.DateTime - alquiler.FechaInicio.DateTime).Days + 1;
            double precio = alquiler.AlquilerItems.Sum(ri => ri.Precio * dias * ri.Cantidad);
            alquiler.PrecioTotal = precio;
            return Convert.ToDecimal(precio);
        }
    }
    private void ModificarAlquilarItems()
    {
        navigation.NavigateTo("/alquiler/selectherramientaparaalquilar");
    }
    private CreacionAlquilerDTO alquiler => 
alquilarState.Alquiler;

    private void OpenDialog()
    {
        DialogIsOpen = true;
    }

    private async Task OnDialogClose(bool isOk)
    {

        DialogIsOpen = false;
        if (isOk)
        {
            if (alquiler.AlquilerItems.Count > 0)
            {
                try
                {
                    var alquilado = await apiclient.CreacionAlquilerAsync(alquiler);
                    alquilarState.AlquilerProcesado();
                    navigation.NavigateTo($"/alquiler/detallealquiler/?AlquilerID={alquilado.Id}");
                }
                catch (ApiException<ValidationProblemDetails> apiexceptionvalidation)
                {

                    if (apiexceptionvalidation.Result.Errors.Values != null)
                    {
                        messageError = "";
                        foreach (var errors in apiexceptionvalidation.Result.Errors.Values)
                            //https://learn.microsoft.com/en-us/dotnet/api/system.string.join?view=net-7.0
                            messageError = string.Join("(*) ", messageError, string.Join(" (*) ", errors));
                    }
                }
                catch (ApiException apiexception)
                {
                    messageError = "Error mientras se procesaba tu pedido, por favor intentelo mas tarde";

                }

            }

        }
    }

    protected override async Task OnInitializedAsync()
    {

        if (authenticationState is not null)
        {
            if (alquiler.AlquilerItems != null)
            {
                foreach (var item in alquiler.AlquilerItems)
                {
                    if (item.Cantidad <= 0)
                    {
                        item.Cantidad = 1;
                    }
                }
            }
            alquiler.FechaInicio = DateTimeOffset.Now;
            alquiler.FechaFin = DateTimeOffset.Now;
            var authState = await authenticationState;
            var user = authState?.User;

            if (user is not null)
            {
                if (user.Identity is not null && user.Identity.IsAuthenticated)
                {
                    alquiler.Name = user.Identity.Name;
                }
            }
            
            alquiler.Name = alquiler.Name == null ? "" : alquiler.Name;
            alquiler.Surname = alquiler.Surname == null ? "" : alquiler.Surname;
            alquiler.DireccionEnvio = alquiler.DireccionEnvio == null ? "" : alquiler.DireccionEnvio;
        }
    }


    [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }
}