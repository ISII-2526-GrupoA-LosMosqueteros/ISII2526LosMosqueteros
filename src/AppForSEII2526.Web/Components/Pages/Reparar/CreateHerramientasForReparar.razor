@page "/Reparar/CreateHerramientasForReparar"
@inject NavigationManager navigation
@using AppForSEII2526.Web.API
@using AppForSEII2526.Web.Components.Shared
@inject AppForHerramientasAPIClient apiclient
@inject ILogger<CreateHerramientasForReparar> logger
@inject ReparacionesStateContainer reparacionState


<h3>CreateHerramientasForReparar</h3>

@* reparacion is the object that will be edited thanks to the form *@
<EditForm Model="reparacion" OnValidSubmit="OpenDialog">
    <div class="row">
        <DataAnnotationsValidator />
        <ValidationSummary class="row alert alert-danger" />
    </div>

    <div class="row alert alert-danger" role="alert" hidden="@hideErrors">
        <p id="ErrorsShown">Errors: @messageError</p>
    </div>

    <div class="row g-3">
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="reparacion.Name" class="form-control" id="Name" />
                <label for="Name">Nombre</label>
            </div>
        </div>
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="reparacion.Surname" class="form-control" id="Surname" />
                <label for="Surname">Apellido</label>
            </div>
        </div>
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputDate @bind-Value="reparacion.FechaEntrega" class="form-control" id="FechaEntrega" />
                <label for="FechaEntrega">Fecha de Entrega</label>
            </div>
        </div>
    </div>
    <div class="row g-2">
        <div class="col-md">
            <div class="form-floating">
                @*a dropdown for selecting the payment method*@
                <InputSelect class="form-select" @bind-Value="@reparacion.TiposMetodoPago" id="MetodoPago">
                    <option value="@TiposMetodoPago.TarjetaCredito" default> Tarjeta de crédito</option>
                    <option value="@TiposMetodoPago.PayPal"> PayPal</option>
                    <option value="@TiposMetodoPago.Efectivo"> Efectivo</option>
                </InputSelect>
                <label for="PaymentMethod">Método de Pago</label>
            </div>


        </div>
        <div class="col-md">
            <div class="form-floating">
                @*this button will be used to ask the user if he want to proceed to reparar the herramienta*@
                <button class="btn btn-primary" type="submit" id="Submit">
                    Repara tus herramientas
                </button>
            </div>
        </div>
    </div>
    <h4>Detalle Reparacion</h4>
    <p>
        <b>Total price:</b> @TotalCost €
        <button class="btn btn-outline-primary" type="button" @onclick="ModificarItemsReparar" id="ModificarHerramientas">
            Modificar herramientas
        </button>
    </p>
    <div class="mh-100 table-responsive">
        <table class="table table-condensed table-hover" id="TableOfRentalItems">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>TiempoReparacion</th>
                    <th>Precio</th>
                    <th>Descripcion</th>
                    <th>Cantidad</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in reparacion.RepararItem)
                {
                    <tr id="HerramientaData_@item.Nombre">
                        <td>@item.Nombre</td>
                        <td>@item.TiempoReparacion</td>
                        <td>@item.Precio</td>
                        <td><InputText @bind-Value="item.Descripcion" class="form-control" id="@($"description_{item.Id}")" /></td>
                        <td><InputNumber @bind-Value="item.Cantidad" class="form-control" id="@($"description_{item.Id}")" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</EditForm>

@*a modal popup dialog for checking if user wants to proceed to repair*@
@if (DialogIsOpen)
{
    <Dialog Caption="Reparar herramientas"
    Message="¿Quieres proceder a reparar las herramientas seleccionadas?"
    OnClose="@OnDialogClose"
    Type=Dialog.Category.SaveNot>
    </Dialog>
}

@code {
    private string messageError = "";
    private bool hideErrors { get { return messageError.Length == 0; } }
    private bool DialogIsOpen;
    private CreacionReparacionDTO reparacion => reparacionState.Reparacion;

    private decimal TotalCost
    {
        get
        {
            int days = (reparacion.FechaRecogida.DateTime - reparacion.FechaEntrega.DateTime).Days;
            double price = reparacion.RepararItem.Sum(ri => ri.Precio * days);
            return Convert.ToDecimal(price);
        }
    }
    private void ModificarItemsReparar()
    {
        navigation.NavigateTo("/Reparar/SelectHerramientasForReparar");
    }

    private void OpenDialog()
    {
        DialogIsOpen = true;
    }

    private async Task OnDialogClose(bool isOk)
    {
        DialogIsOpen = false;
        if (isOk)
        {
            // Process the data introduced by the user if they are valid
            if (reparacion.RepararItem.Count > 0)
            {
                try
                {
                    var reparado = await apiclient.CrearReparacionAsync(reparacion);
                    reparacionState.ReparacionProcessed();
                    navigation.NavigateTo($"/Reparar/DetalleHerramientaForReparar?ReparacionID={reparado.Id}");
                }

                catch (ApiException<ValidationProblemDetails> apiexceptionvalidation)
                {
                    if (apiexceptionvalidation.Result.Errors.Values != null)
                    {
                        messageError = "";
                        foreach (var errors in apiexceptionvalidation.Result.Errors.Values)
                            //https://learn.microsoft.com/en-us/dotnet/api/system.string.join?view=net-7.0
                            messageError = string.Join("(*) ", messageError, string.Join(" (*) ", errors));
                    }
                }
                catch (ApiException apiexception)
                {
                    //we need to inform user that there was some other error while processing the request
                    messageError = "Error while processing your request, please try again later!";
                }
            }
        }
    }

}
